rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // لعبة بين أصحاب: أي حد معاه اللينك يقدر يقرا/يكتب في الروم بتاعته.
    // مفيش تسجيل دخول، فده أبسط شكل آمن نسبيًا لعدد قليل من الأصحاب.
    match /rooms/{roomId} {
      allow read, write: if true;
    }
  }
}
